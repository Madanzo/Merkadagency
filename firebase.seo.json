{
  "hosting": {
    "site": "merkadagency-dd2aa",
    "public": "dist-site",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/services",
        "destination": "/services/website-development",
        "type": 301
      },
      {
        "source": "/book",
        "destination": "/contact",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/admin{,/**}",
        "destination": "/private-app.html"
      },
      {
        "source": "/sign/**",
        "destination": "/private-app.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/private-app.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex,nofollow"
          }
        ]
      },
      {
        "source": "/admin{,/**}",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex,nofollow"
          }
        ]
      },
      {
        "source": "/sign/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex,nofollow"
          }
        ]
      }
    ],
    "predeploy": [
      "npm run verify:seo"
    ]
  }
}
